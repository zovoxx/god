class_name Synth
extends RefCounted
## Tiny offline synthesiser: renders notes (sine/triangle/square/saw/noise with envelopes,
## pitch sweeps and a one-pole low-pass) into a float buffer, then packs a 16-bit
## AudioStreamWAV. Used for every sound effect and the layered music.

const RATE := 22050

static func buffer(seconds: float, rate: int = RATE) -> PackedFloat32Array:
	var b := PackedFloat32Array()
	b.resize(int(seconds * rate))
	return b

## adds one voice. wave: 0 sine, 1 tri, 2 square, 3 saw, 4 noise
static func voice(b: PackedFloat32Array, start: float, dur: float, f0: float, f1: float, wave: int, vol: float,
		attack: float = 0.005, release: float = 0.08, lp: float = 1.0, rate: int = RATE, seed_v: int = 1) -> void:
	var s0 := int(start * rate)
	var n := int(dur * rate)
	var ph := 0.0
	var y := 0.0
	var rnd := seed_v * 1103515245 + 12345
	var att := maxi(1, int(attack * rate))
	var rel := maxi(1, int(release * rate))
	for i in n:
		var idx := s0 + i
		if idx >= b.size():
			break
		var k := float(i) / float(n)
		var f := f0 + (f1 - f0) * k
		ph += f / rate
		ph -= floorf(ph)
		var v := 0.0
		match wave:
			0: v = sin(ph * TAU)
			1: v = 4.0 * absf(ph - 0.5) - 1.0
			2: v = 1.0 if ph < 0.5 else -1.0
			3: v = 2.0 * ph - 1.0
			_:
				rnd = (rnd * 1103515245 + 12345) & 0x7fffffff
				v = float(rnd) / 1073741824.0 - 1.0
		y += (v - y) * lp
		var env := 1.0
		if i < att:
			env = float(i) / att
		elif i > n - rel:
			env = float(n - i) / rel
		b[idx] += y * vol * env

static func to_wav(b: PackedFloat32Array, rate: int = RATE, loop: bool = false) -> AudioStreamWAV:
	var data := PackedByteArray()
	data.resize(b.size() * 2)
	var peak := 0.0001
	for v in b:
		peak = maxf(peak, absf(v))
	var g := 1.0 / peak if peak > 1.0 else 1.0
	for i in b.size():
		data.encode_s16(i * 2, int(clampf(b[i] * g, -1.0, 1.0) * 32000.0))
	var w := AudioStreamWAV.new()
	w.format = AudioStreamWAV.FORMAT_16_BITS
	w.mix_rate = rate
	w.stereo = false
	w.data = data
	if loop:
		w.loop_mode = AudioStreamWAV.LOOP_FORWARD
		w.loop_begin = 0
		w.loop_end = b.size()
	return w

static func midi(n: float) -> float:
	return 440.0 * pow(2.0, (n - 69.0) / 12.0)

