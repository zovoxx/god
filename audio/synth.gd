static func render_sfx(id: String) -> AudioStreamWAV:
	var R := sfx_recipes()
	if not R.has(id):
		return null
	var r: Array = R[id]
	var b := buffer(float(r[0]))
	var i := 0
	for v in r[1]:
		i += 1
		voice(b, float(v[0]), float(v[1]), float(v[2]), float(v[3]), int(v[4]), float(v[5]), float(v[6]), float(v[7]), float(v[8]), RATE, i * 7919 + id.hash())
	return to_wav(b)

# ───────────────────────── music ─────────────────────────
## Layered loops per depth: 0 explore (pad + arpeggio), 1 combat (bass + drums), 2 streak
## (fast lead), 3 boss (heavy drums + brass stabs). All layers share length and tempo so they
## stay in sync and are faded in/out by intensity.

const MRATE := 16000
const SCALES := [
	[57, [0, 3, 7, 10], [0, 5, 3, 7]],     # gardens: A minor-ish
	[50, [0, 3, 7, 10], [0, 8, 5, 3]],     # archive: D minor
	[52, [0, 3, 6, 10], [0, 1, 5, 3]],     # foundry: E dim-ish
	[54, [0, 3, 7, 11], [0, 8, 1, 5]],     # crown: F# minor-maj7
	[60, [0, 4, 7, 11], [0, 5, 9, 7]],     # wick: C major 7
]

static func render_music(depth_i: int, layer: int) -> AudioStreamWAV:
	var S: Array = SCALES[clampi(depth_i, 0, SCALES.size() - 1)]
	var root: int = S[0]
	var chord: Array = S[1]
	var prog: Array = S[2]
	var bpm := 112.0 + depth_i * 6.0
	var beat := 60.0 / bpm
	var bars := 4
	var len_s := beat * 4.0 * bars
	var b := buffer(len_s, MRATE)
	for bar in bars:
		var t0 := bar * beat * 4.0
		var deg: int = prog[bar % prog.size()]
		match layer:
			0:
				for c in chord.slice(0, 3):
					voice(b, t0, beat * 4.0, midi(root + deg + int(c)), midi(root + deg + int(c)), 1, 0.10, 0.4, 0.6, 0.15, MRATE)
				for i in 8:
					var n: int = chord[i % chord.size()]
					voice(b, t0 + i * beat * 0.5, beat * 0.45, midi(root + 12 + deg + n), midi(root + 12 + deg + n), 0, 0.07, 0.01, 0.2, 1.0, MRATE)
			1:
				for i in 8:
					var bn: int = root - 12 + deg + (7 if i % 4 == 3 else 0)
					voice(b, t0 + i * beat * 0.5, beat * 0.42, midi(bn), midi(bn), 3, 0.16, 0.005, 0.06, 0.12, MRATE)
				for i in 4:
					voice(b, t0 + i * beat, 0.16, 110.0, 40.0, 0, 0.45, 0.001, 0.12, 1.0, MRATE)
					voice(b, t0 + i * beat + beat * 0.5, 0.05, 8000.0, 6000.0, 4, 0.08, 0.001, 0.04, 0.6, MRATE, i + bar * 9)
				voice(b, t0 + beat, 0.12, 900.0, 300.0, 4, 0.18, 0.001, 0.1, 0.35, MRATE, bar)
				voice(b, t0 + beat * 3.0, 0.12, 900.0, 300.0, 4, 0.18, 0.001, 0.1, 0.35, MRATE, bar + 3)
			2:
				for i in 16:
					var n2: int = chord[(i * 3) % chord.size()]
					var nn: int = root + 24 + deg + n2
					voice(b, t0 + i * beat * 0.25, beat * 0.22, midi(nn), midi(nn), 2, 0.05, 0.002, 0.08, 0.3, MRATE)
			3:
				for i in 8:
					voice(b, t0 + i * beat * 0.5, 0.2, 90.0, 35.0, 0, 0.5, 0.001, 0.15, 1.0, MRATE)
				for i in [0, 3, 6]:
					var sn: int = root - 12 + deg
					voice(b, t0 + i * beat * 0.5, beat * 0.4, midi(sn), midi(sn), 3, 0.18, 0.01, 0.1, 0.08, MRATE)
					voice(b, t0 + i * beat * 0.5, beat * 0.4, midi(sn + 7), midi(sn + 7), 3, 0.12, 0.01, 0.1, 0.08, MRATE)
	return to_wav(b, MRATE, true)
