[gd_resource type="Resource" script_class="BoonData" load_steps=2 format=3]

[ext_resource type="Script" path="res://config/boon_data.gd" id="1_bd"]

[resource]
script = ExtResource("1_bd")
order = ["ember", "rime", "storm", "tide", "dawn", "gale", "umbra", "thorn"]
rarity = {
"mul": [1.0, 1.35, 1.75, 2.2],
"level_step": 0.3,
"chance_rare": 0.24,
"chance_epic": 0.08,
"chance_legendary": 0.025,
"duo_chance": 0.35,
"max_level": 6
}
patrons = {
"ember": {"name": "Ashka", "title": "the Kiln", "color": "#ff7a2a", "theme": "Burn: stacking fire damage", "greet": ["Make them crackle, little wick.", "Burn bright. Burn everything.", "Ash remembers. Feed it."]},
"rime": {"name": "Ilvra", "title": "the Rime Widow", "color": "#8fe8ff", "theme": "Chill → Freeze → Shatter", "greet": ["Stillness is a gift. Give it freely.", "Let them slow. Let them stop.", "Cold is patient. So am I."]},
"storm": {"name": "Korr", "title": "the Thunder Ram", "color": "#ffe24a", "theme": "Lightning that chains between foes", "greet": ["HA! Let it arc!", "One strike, many cracks.", "Charge them. All of them."]},
"tide": {"name": "Maelis", "title": "the Deep Tide", "color": "#3d9bff", "theme": "Knockback and wall slams", "greet": ["Push. Then push harder.", "The deep returns all things to stone.", "Let them break upon you."]},
"dawn": {"name": "Solenne", "title": "the Dawnmother", "color": "#fff1a6", "theme": "Radiant marks and critical hits", "greet": ["Find the seam of light in them.", "Every dawn begins with one bright cut.", "Shine true, child."]},
"gale": {"name": "Siffra", "title": "the Running Wind", "color": "#8dffc8", "theme": "Speed, dash charges and wind blades", "greet": ["Faster! They can barely see you.", "Never stop moving.", "Ride me, little flame."]},
"umbra": {"name": "Oruun", "title": "the Hollow Eye", "color": "#b45cff", "theme": "Hex: curses that spread on death", "greet": ["Curses travel well.", "Let the dark do the work.", "One death, then another. Then another."]},
"thorn": {"name": "Brakka", "title": "the Thornmother", "color": "#86e04a", "theme": "Bleed stacks that burst on heavy hits", "greet": ["Let them carry my thorns home.", "Wound, then rend.", "Every cut takes root."]}
}
