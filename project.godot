; Engine configuration file.
config_version=5

[application]

config/name="Lanternfall"
config/description="Wren, the last Kindler, descends four depths to take back a stolen sun."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=144
boot_splash/bg_color=Color(0.04, 0.03, 0.06, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

driver/mix_rate=44100

[autoload]

Bus="*res://autoload/bus.gd"
Cfg="*res://autoload/cfg.gd"
Assets="*res://render/assets.gd"
Audio="*res://audio/audio.gd"
App="*res://autoload/app.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=6
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/canvas_textures/default_texture_filter=1
anti_aliasing/quality/msaa_2d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.04, 0.03, 0.06, 1)
2d/batching/item_buffer_size=16384
quality/driver/low_end=true
textures/default_filters/anisotropic_filtering_level=0
lights_and_shadows/positional_shadow/atlas_size=256
